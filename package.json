{
  "name": "cue",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "npm": ">=11.10.0"
  },
  "scripts": {
    "dev": "CLOUDFLARE_CF_FETCH_ENABLED=false vite",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy --config dist/cue/wrangler.json",
    "test": "node --test",
    "model:check": "hug-models outdated",
    "format": "prettier --write \"**/*.{html,css,js,json,jsonc,md}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,json,jsonc,md}\""
  },
  "dependencies": {
    "hug-models": "^0.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "prettier": "^3.9.6",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.114.0"
  }
}
